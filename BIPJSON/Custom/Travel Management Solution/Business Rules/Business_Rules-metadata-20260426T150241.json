        "source": "xml-tag:sql",
        "name": "sql-1",
        "sql": "<![CDATA[SELECT account.SEGMENT_VALUE1,account.SEGMENT_VALUE2,account.SEGMENT_VALUE3,account.SEGMENT_VALUE4,account.SEGMENT_VALUE5,account.SEGMENT_VALUE6,account.SEGMENT_VALUE7,account.SEGMENT_VALUE8,account.SEGMENT_VALUE9\n      \n  ,balances.period_name,\n        c_budget.name AS budget_name,\n        c_budget.control_level_code,\n       balances.funds_available_amount\n    FROM\n        xcc_budget_accounts account,\n        xcc_balances_v balances,\n        xcc_control_budgets c_budget\n  \nWHERE\n        balances.budget_ccid = account.budget_code_combination_id\n        AND balances.control_budget_id = c_budget.control_budget_id\n        AND c_budget.status_code = 'IN_USE'\n        AND account.segment_value5 in (2104301,2104302,2104303,2215101,2215102,2215103,2215104,2215105,2215106,2215201,2215202,2215203,2215204,2215205,2215208,2215209,2215210,2215211,2215212)\nand balances.period_name like '%26%'\n--and  c_budget.control_level_code in ('ABSOLUTE','ADVISORY')\n]]>",
